# Database Configuration
# Set this to a Neon database connection string for production.
# Leave unset or empty for local development (uses embedded PGLite).
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# Application Server
# Port for development server (default: 8080)
VITE_DEV_SERVER_PORT=8080

# Authentication
# Better Auth configuration (if using OAuth or external providers)
# BETTER_AUTH_SECRET=your-secret-here
# BETTER_AUTH_URL=http://localhost:8080
